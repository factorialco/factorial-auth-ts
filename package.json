{
  "name": "@factorialco/factorial-auth",
  "version": "0.1.0",
  "description": "Decode and verify Factorial ID JWT tokens.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "checks": "npm-run-all --parallel checks:*",
    "checks:lint": "oxlint",
    "checks:format": "oxfmt --check",
    "checks:tsc": "tsgo --noEmit -p tsconfig.json",
    "checks:knip": "pnpm knip --no-config-hints"
  },
  "dependencies": {
    "knip": "^6.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260320.1",
    "@vitest/coverage-v8": "^4.1.9",
    "msw": "^2.14.6",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "0.28.0",
    "oxlint": "^1.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
