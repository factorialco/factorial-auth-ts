{
  "name": "@factorialco/auth",
  "version": "0.2.0",
  "description": "Verify Factorial ID tokens and request OAuth grants.",
  "keywords": [
    "authentication",
    "factorial",
    "factorial-id",
    "jose",
    "jwks",
    "jwt",
    "oidc",
    "token-verification"
  ],
  "homepage": "https://github.com/factorialco/factorial-auth-ts#readme",
  "bugs": {
    "url": "https://github.com/factorialco/factorial-auth-ts/issues"
  },
  "license": "MIT",
  "author": "Factorial <dev@factorial.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/factorialco/factorial-auth-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "node scripts/prepare.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "checks": "npm-run-all --parallel checks:*",
    "checks:lint": "oxlint",
    "checks:format": "oxfmt --check",
    "checks:tsc": "tsgo --noEmit -p tsconfig.json",
    "checks:knip": "pnpm knip --no-config-hints",
    "checks:package": "pnpm pack --out tmp/pkg.tgz && attw tmp/pkg.tgz --profile node16 && publint run tmp/pkg.tgz --strict"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260320.1",
    "@vitest/coverage-v8": "^4.1.9",
    "knip": "^6.23.0",
    "lefthook": "^2.1.9",
    "msw": "^2.14.6",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "0.28.0",
    "oxlint": "^1.0.0",
    "publint": "^0.3.21",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
